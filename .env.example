# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth — REQUIRED. Generate a unique value with: openssl rand -base64 32
# Never commit your real secret. Keep this placeholder in .env.example.
NEXTAUTH_SECRET="REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI — Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Email — Gmail App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Lemon Squeezy — https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Optional: Upstash Redis for distributed rate limiting (https://console.upstash.com).
# If unset, rate limits use per-process in-memory state — fine for single-instance deploys.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
