// This is your Prisma schema file
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CoinTransactionType {
  PURCHASE
  GENERATION
  ADMIN_GRANT
  NEW_USER_BONUS
  QUIZ_REWARD
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  avatarUrl     String?
  nativeLanguage String   @default("Bengali")
  dailyGoal     Int       @default(10)
  emailVerified DateTime?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  coins         Int       @default(0)

  words         Word[]
  quizzes       Quiz[]
  streak        Streak?
  accounts      Account[]
  sessions      Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  coinTransactions        CoinTransaction[]
  orders                  Order[]
  apiKeys                 ApiKey[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Word {
  id              String   @id @default(cuid())
  userId          String
  englishWord     String
  meaning         String   // In user's native language
  exampleSentence            String?
  exampleSentenceTranslation String?
  difficultyLevel Int      @default(1) // 1=Easy, 2=Medium, 3=Hard
  tags            String   @default("") // comma-separated tags
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordStats       WordStats?
  quizQuestions   QuizQuestion[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("words")
}

model WordStats {
  id           String   @id @default(cuid())
  wordId       String   @unique
  correctCount Int      @default(0)
  wrongCount   Int      @default(0)
  lastReviewed DateTime?
  nextReview   DateTime? // For SRS scheduling
  easeFactor   Float    @default(2.5) // SRS ease factor

  word         Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([nextReview])
  @@map("word_stats")
}

model Quiz {
  id             String         @id @default(cuid())
  userId         String
  score          Int            @default(0)
  totalQuestions Int
  timeTaken      Int?           // seconds
  quizType       String         @default("mixed") // mixed, multiple_choice, fill_blank, reverse
  createdAt      DateTime       @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions      QuizQuestion[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("quizzes")
}

model QuizQuestion {
  id            String  @id @default(cuid())
  quizId        String
  wordId        String
  questionType  String  // multiple_choice, fill_blank, reverse
  userAnswer    String?
  correctAnswer String
  isCorrect     Boolean @default(false)
  options       String  @default("") // JSON array of options for MC

  quiz          Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  word          Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model Streak {
  id          String   @id @default(cuid())
  userId      String   @unique
  currentDays Int      @default(0)
  longestDays Int      @default(0)
  lastActivity DateTime?
  totalXP     Int      @default(0)
  level       Int      @default(1)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String
  prefix      String
  tokenHash   String    @unique
  scopes      String    @default("read,write")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("api_keys")
}

model AppSettings {
  id             String   @id @default("singleton")
  newUserCoins   Int      @default(50)
  generationCost Int      @default(10)
  dailyQuizCoins Int      @default(20)
  updatedAt      DateTime @updatedAt

  @@map("app_settings")
}

model CoinPackage {
  id          String   @id @default(cuid())
  name        String
  coins       Int
  priceUsd    Int      // in cents (100 = $1.00)
  lsVariantId String?  // Lemon Squeezy variant ID (required for checkout)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  orders      Order[]

  @@map("coin_packages")
}

model CoinTransaction {
  id          String              @id @default(cuid())
  userId      String
  amount      Int
  type        CoinTransactionType
  description String
  lsOrderId   String?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("coin_transactions")
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  packageId String
  lsOrderId String?     @unique  // Lemon Squeezy order ID, set on webhook confirmation
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  package   CoinPackage @relation(fields: [packageId], references: [id])

  @@index([userId])
  @@map("orders")
}
